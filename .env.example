# CampusOS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://campusos:campusos@localhost:5432/campusos

# ─── Security ────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── LLM (not needed for Phase 1) ───────────────────────────────────
# LLM_API_KEY=

# ─── Redis (not needed for Phase 1) ─────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
